{
  // Worker + site estático. Deploy: npm run cf:deploy (ou o workflow .github/workflows/cloudflare.yml).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marouane-portfolio",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // O Worker roda antes dos assets só nestas rotas; o resto é servido direto (grátis e sem limite).
    "run_worker_first": ["/", "/api/*"]
  },
  "vars": {
    "RESEND_FROM": "Portfolio <onboarding@resend.dev>",
    "CONTACT_SEND_CONFIRMATION": "false"
  }
  // Segredos (não ficam no arquivo): npx wrangler secret put RESEND_API_KEY
  // Opcional: CONTACT_TO_EMAIL (padrão: email em src/content/profile.ts)
}
