# Copie para .env.local e preencha. Nunca faça commit de .env.local.

# URL pública do site (usada em canonical, sitemap, Open Graph e llms.txt).
# No Render, se vazio, usa RENDER_EXTERNAL_URL automaticamente.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Formulário de contato (Resend: https://resend.com)
RESEND_API_KEY=
# Remetente. Sem domínio verificado, use o padrão do Resend.
RESEND_FROM=Portfolio <onboarding@resend.dev>
# Destino das mensagens. Padrão: email em src/content/profile.ts
CONTACT_TO_EMAIL=
# Só ative com domínio verificado no Resend (permite enviar para o visitante).
CONTACT_SEND_CONFIRMATION=false
